# The club table. Leave these unset and the game is exactly what it was
# before any of it existed: local, private, and with none of the leaderboard
# code in the bundle at all.
#
# Copy to .env.local for development. For the deployed site, set them as
# repository secrets and pass them to the build step in deploy.yml.
#
# The anon key is meant to be public — it identifies the project and
# authorises nothing. Row level security decides who may read and write, which
# is why supabase/migrations is the real security model. The service role key
# is NOT public and must never appear here or in the client; it lives only in
# the edge functions' own environment, which Supabase sets for you.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
